{
  "name": "rulicon",
  "description": "Rulicon extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:userscript": "vite build --config vite.userscript.config.ts",
    "test:userscript": "bun run build:userscript && bun tests/userscript-build.mjs",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fix": "bun run lint:fix && bun run fmt",
    "validate": "bun run lint && bun run fmt:check"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/jquery": "^4.0.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "dependencies": {
    "lucide-preact": "^1.54.0",
    "preact": "^11.0.1"
  }
}
